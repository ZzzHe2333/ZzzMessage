:80 {
    encode gzip
    # PWA navigations and service-worker script must not become stale at proxy.
    @fresh path / /index.html /sw.js /manifest.webmanifest /login /message /friend /setting /gift /money /api-key
    header @fresh Cache-Control "no-cache, max-age=0, must-revalidate"
    handle /api/* {
        reverse_proxy server:58463
    }
    # Public browser paths are all handled by one Vue SPA.
    @pages path /login /setting /message /friend
    handle @pages {
        root * /srv
        rewrite * /index.html
        file_server
    }
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
