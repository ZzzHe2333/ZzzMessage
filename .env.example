# Copy to .env; generate secrets with: openssl rand -hex 32
# Both variables are REQUIRED. Keep them private and do not commit .env.
INVITE_CODE=
SESSION_SECRET=
# Comma-separated origins of the PWA frontend, e.g. https://chat.example.com
ALLOWED_ORIGINS=http://localhost:58463,http://localhost:58464,http://127.0.0.1:58463,http://127.0.0.1:58464
# Optional host port override (the Go service inside Docker remains on 58463)
APP_PORT=58463
